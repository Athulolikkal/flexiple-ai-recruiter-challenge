# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# Required. The server will refuse to start without it.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Gemini model to use for all LLM calls. "gemini-flash-latest" is a
# Google-maintained alias that always points at their current recommended flash
# model, so it doesn't need updating as specific model versions are deprecated.
GEMINI_MODEL=gemini-flash-latest

# Optional. Port the NestJS server listens on.
PORT=4000

# Optional. Origin allowed to call the API (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173
